# ==============================================================================
# LLM 可解释性交互工坊 (Transformer vs RWKV) - 后端环境变量配置模板
# 复制本文件为 backend/.env 并根据实际环境调整配置
# ==============================================================================

# 1. Transformer 架构模型路径
# 默认指向项目内 backend/models/Qwen3.5-0.8B-GGUF (目录或 .gguf 文件)
# 支持绝对路径、相对路径或 HuggingFace / ModelScope 仓库 ID (例如 unsloth/Qwen3.5-0.8B-GGUF)
DEFAULT_TRANSFORMER=backend/models/Qwen3.5-0.8B-GGUF

# 2. RWKV-7 架构模型路径
# 默认指向项目内 backend/models/rwkv7-g1d-0.4b-20260210-ctx8192.pth
# 支持绝对路径、相对路径或 HuggingFace 仓库 ID
DEFAULT_RWKV=backend/models/rwkv7-g1d-0.4b-20260210-ctx8192.pth

# 3. 运行推理设备: cuda (推荐，需 NVIDIA 显卡) 或 cpu
DEVICE=cuda

# 4. HuggingFace 镜像源加速地址 (若从 HF 在线拉取权重，国内网络推荐使用镜像站)
HF_ENDPOINT=https://hf-mirror.com

# 5. 跨域访问白名单 (逗号分隔，默认允许常见本地开发前端端口)
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
