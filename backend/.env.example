# ==============================================================================
# LLM 可解释性交互工坊 (Transformer / RWKV / Mamba) - 后端环境变量配置模板
# 复制本文件为 backend/.env 并根据实际环境调整配置
# ==============================================================================

# 1. Transformer 架构模型路径
# 默认指向项目内 backend/models/Qwen3.5-0.8B-GGUF (目录或 .gguf 文件)
# 支持绝对路径、相对路径或 HuggingFace / ModelScope 仓库 ID (例如 unsloth/Qwen3.5-0.8B-GGUF)
# 相对路径以 backend/ 目录为基准解析；本机绝对路径（如 D:/...）只放在未提交的 backend/.env 中。
DEFAULT_TRANSFORMER=models/Qwen3.5-0.8B-GGUF

# 2. RWKV-7 架构模型路径
# 默认指向项目内 backend/models/rwkv7-g1d-0.4b-20260210-ctx8192.pth
# 支持绝对路径、相对路径或 HuggingFace 仓库 ID
DEFAULT_RWKV=models/rwkv7-g1d-0.4b-20260210-ctx8192.pth

# 3. Mamba 架构模型路径
# 默认使用 Hugging Face 官方兼容仓库；也支持本地目录/绝对路径
DEFAULT_MAMBA=state-spaces/mamba-130m-hf

# 4. 纯注意力对照模型（仅概念实验室使用，不新增顶层架构 Tab）
# 默认使用 Hugging Face 原生 Qwen2 模型 ID；也支持本地目录/绝对路径
DEFAULT_ATTENTION_BASELINE=Qwen/Qwen2.5-0.5B

# 4. 运行推理设备: cuda (推荐，需 NVIDIA 显卡) 或 cpu
DEVICE=cuda

# 5. HuggingFace 镜像源加速地址 (若从 HF 在线拉取权重，国内网络推荐使用镜像站)
HF_ENDPOINT=https://hf-mirror.com

# 6. 跨域访问白名单 (逗号分隔，默认允许常见本地开发前端端口)
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# 7. 会话生命周期与并发控制 (超时秒数 / 最大活跃会话数，超限时触发 LRU 淘汰并释放 GPU 显存)
# SESSION_TTL_SECONDS=1800
# MAX_SESSIONS=10

# 8. 模型适配器类型名 (注册表键名，需与 @register_adapter 注册的名字一致)
# MODEL_TYPE=transformer
# RWKV_MODEL_TYPE=rwkv
# MAMBA_MODEL_TYPE=mamba
# ATTENTION_BASELINE_MODEL_TYPE=attention_baseline
