# ==============================================================================
# LLM 可解释性交互工坊 - 前端环境变量配置模板
# 复制本文件为 frontend/.env.local 即可自定义配置
# ==============================================================================

# 后端 HTTP API 基础地址（默认直接连接本地 8000 端口）
VITE_API_BASE=http://127.0.0.1:8000

# 后端 WebSocket 基础地址（可选，默认根据 VITE_API_BASE 自动推导）
VITE_WS_BASE=ws://127.0.0.1:8000
